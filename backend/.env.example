DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_NAME=dawana_dev
DB_TEST_NAME=test_dawana_dev
DB_USER=dawana_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_HTTP_TIMEOUT_SECONDS=10

# Recovery email is disabled until an email backend is explicitly configured.
DIC_EMAIL_RECOVERY_ENABLED=False
DIC_RECOVERY_DELIVERY_WORKER_ENABLED=False
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DIC_RECOVERY_ENCRYPTION_KEY=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.org
DIC_RECOVERY_PROVIDER_TIMEOUT_SECONDS=8

# SMS requires a project-approved adapter implementing send(destination, code).
DIC_SMS_RECOVERY_ADAPTER=

# Official WhatsApp Cloud API OTP template settings; leave blank to disable.
DIC_WHATSAPP_ACCESS_TOKEN=
DIC_WHATSAPP_PHONE_NUMBER_ID=
DIC_WHATSAPP_API_VERSION=v23.0
DIC_WHATSAPP_OTP_TEMPLATE=
DIC_WHATSAPP_OTP_LANGUAGE=en
DIC_WHATSAPP_SUPPORT_NUMBER=

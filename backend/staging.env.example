# Render environment editor only; never copy real secrets into tracked files.
DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend-staging.onrender.com
DJANGO_CORS_ALLOWED_ORIGINS=https://your-separate-staging-site.netlify.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-separate-staging-site.netlify.app
DATABASE_URL=
STAGING_DATABASE_NAME=
DB_CONN_MAX_AGE=60
PYTHON_VERSION=3.13.14
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=

# Safe preparation template, not an active production environment.
# Use the custom host values only AFTER owner-approved DNS/Render/TLS setup.
DJANGO_SETTINGS_MODULE=config.settings.render
PUBLIC_HOST=api.dawanaislamicfoundation.org
# Optional exact aliases; no schemes, ports, paths, spaces or wildcards.
# For migration, keep PUBLIC_HOST at the existing Render hostname and set:
# PUBLIC_HOST_ALIASES=api.dawanaislamicfoundation.org
FRONTEND_ORIGIN=https://dawanaislamicfoundation.org
DAWANA_WEBSITE_ONLY=false
# Required secrets: provision in Render, never commit actual values.
DJANGO_SECRET_KEY=REPLACE_WITH_INDEPENDENT_SECRET_AT_LEAST_50_CHARACTERS
DATABASE_URL=postgresql://REPLACE_ROLE:REPLACE_PASSWORD@REPLACE_FULL_DB_HOST/REPLACE_DATABASE
DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/existing/trusted/ca-bundle.pem
DIC_PORTAL_FRONTEND_URL=https://dawanaislamicfoundation.org/dic/participant
DIC_PORTAL_EMAIL_VERIFY_URL=https://dawanaislamicfoundation.org/dic/participant
PAYSTACK_CALLBACK_URL=https://dawanaislamicfoundation.org/dic/register/payment-return
# No collection: live activation is a separate owner approval.
PAYSTACK_MODE=test
PAYSTACK_LIVE_ENABLED=false
PAYSTACK_SECRET_KEY=
# Enable only after isolated schema, delivery, actor and browser acceptance.
DIC_PORTAL_ACCOUNTS_ENABLED=false
DIC_BACKGROUND_WORKER_ENABLED=false
DIC_EMAIL_RECOVERY_ENABLED=false
DIC_RECOVERY_DELIVERY_WORKER_ENABLED=false
DIC_AUTO_FULFILLMENT_ENABLED=false
DIC_ASSISTED_BOOKING_ENABLED=false
FOUNDATION_DONATIONS_ENABLED=false
FOUNDATION_CONTACT_FORM_ENABLED=false
DIC_MEMORY_STORAGE=disabled
DIC_PORTRAIT_CUTOVER_VERIFIED=false
# Full registration launch additionally requires reviewed delivery configuration:
# EMAIL_BACKEND=config.https_email.EmailBackend
# DEFAULT_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER
# RESEND_API_KEY=REPLACE_IN_RENDER_ONLY
# DIC_RECOVERY_ENCRYPTION_KEY=REUSE_APPROVED_EXISTING_KEY
# DIC_AUTOMATION_ACTOR_ID=REVIEWED_HOUSING_ACTOR_ID
# DIC_AUTO_FULFILLMENT_ACTOR_ID=SEPARATELY_REVIEWED_ID_ACTOR_ID
# R2: set DIC_MEMORY_STORAGE=s3 after provisioning/acceptance; credentials independent.
# DIC_MEDIA_S3_BUCKET=dawana-production-media
# DIC_MEDIA_S3_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
# DIC_MEDIA_S3_REGION=auto
# DIC_MEDIA_S3_ACCESS_KEY_ID=REPLACE_IN_RENDER_ONLY
# DIC_MEDIA_S3_SECRET_ACCESS_KEY=REPLACE_IN_RENDER_ONLY
# DIC_PRIVATE_S3_BUCKET=dawana-production-private
# DIC_PRIVATE_S3_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
# DIC_PRIVATE_S3_REGION=auto
# DIC_PRIVATE_S3_ACCESS_KEY_ID=REPLACE_WITH_SEPARATE_KEY_IN_RENDER_ONLY
# DIC_PRIVATE_S3_SECRET_ACCESS_KEY=REPLACE_IN_RENDER_ONLY

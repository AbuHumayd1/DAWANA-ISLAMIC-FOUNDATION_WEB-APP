# Only in a NEW staging Netlify site; never set these on the live main site.
DAWANA_STAGING_FRONTEND=true
DAWANA_STAGING_SITE_ID=the-new-staging-site-id
# SITE_ID is supplied by Netlify. For isolated local build checks, set it to the same staging ID.
STAGING_BACKEND_ORIGIN=https://your-backend-staging.onrender.com
VITE_API_BASE_URL=/api/v1

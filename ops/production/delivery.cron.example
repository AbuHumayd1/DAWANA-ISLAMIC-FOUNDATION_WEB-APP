* * * * * cd /srv/dawana/backend && flock -n /run/lock/dawana-recovery.lock /srv/dawana/venv/bin/python manage.py send_dic_recovery_messages --limit 100
* * * * * cd /srv/dawana/backend && flock -n /run/lock/dawana-queue-health.lock /srv/dawana/venv/bin/python manage.py delivery_queue_health --max-age-seconds 90
0 * * * * cd /srv/dawana/backend && flock -n /run/lock/dawana-recovery-cleanup.lock /srv/dawana/venv/bin/python manage.py cleanup_dic_recovery
5 * * * * cd /srv/dawana/backend && flock -n /run/lock/dawana-access-cleanup.lock /srv/dawana/venv/bin/python manage.py cleanup_dic_participant_access

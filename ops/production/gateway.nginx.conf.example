# Design template only. Requires separately approved TLS termination, hostname,
# trusted immediate ingress and immutable frontend build deployment.
# Standalone direct TLS edge example. Do not use this unchanged behind a managed
# ingress: its verified client-address protocol must first be reviewed.
server {
    listen 443 ssl;
    server_name foundation.example.invalid;
    if ($host != foundation.example.invalid) { return 444; }
    ssl_certificate /etc/dawana/approved-fullchain.pem;
    ssl_certificate_key /etc/dawana/approved-private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/dawana/frontend/dist;
    index index.html;
    client_max_body_size 101m;
    # Default access/error logs can contain participant paths and query strings.
    # Use separately reviewed aggregate ingress metrics, without request URLs.
    access_log off;
    error_log /dev/null;
    add_header X-Content-Type-Options nosniff always;

    location ~ ^/(api|admin|static)(/|$) {
        proxy_pass http://127.0.0.1:10000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Dawana-Client-IP $remote_addr;
        proxy_cache off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header Cache-Control "private, no-store" always;
    }
    # No raw filesystem media and no accidental SPA response for reserved URLs.
    location ~ ^/(media|health)(/|$) { return 404; }
    location = /index.html { add_header Cache-Control "no-store" always; }
    location / { try_files $uri $uri/ /index.html; }
}
